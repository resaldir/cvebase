---
import Feed from "../islands/Feed";
import Layout from "../layouts/Layout.astro";
import { url } from "../lib/base";
import { loadSettings } from "../lib/config";
import { loadLatest } from "../lib/data/repo";
import { productMetas } from "../lib/site-data";

const settings = loadSettings();
const latest = loadLatest();
const rows = settings.appSqli ? latest.rows : latest.rows.filter((r) => r.category !== "app_sqli");
---

<Layout wide>
  <div class="mb-4 flex flex-wrap items-end justify-between gap-2">
    <div>
      <h1 class="text-2xl font-bold tracking-tight">Database CVEs</h1>
      <p class="muted text-sm">
        Newest first. Only vulnerabilities in database engines, tooling and drivers on the
        <a href={url("/products/")}>watchlist</a>.
      </p>
    </div>
  </div>
  <Feed
    client:load
    initialRows={rows}
    shards={latest.shards}
    total={latest.total}
    products={productMetas()}
    timeZone={settings.timezone}
    generatedAt={latest.generated_at}
    appSqli={settings.appSqli}
  />
</Layout>
