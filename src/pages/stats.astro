---
import Chart from "../islands/Chart";
import Layout from "../layouts/Layout.astro";
import { cveUrl, productUrl } from "../lib/base";
import { loadSettings } from "../lib/config";
import { loadCveMap, loadStats } from "../lib/data/repo";
import { formatDate, formatDateTime, severityClass, severityLabel } from "../lib/format";
import { severities } from "../lib/schemas/data";
import { productMetaMap } from "../lib/site-data";

const stats = loadStats();
const settings = loadSettings();
const products = productMetaMap();
const cves = loadCveMap();
const t = stats.totals;
const maxProduct = Math.max(1, ...stats.byProduct.map((p) => p.total));
const withCves = stats.byProduct.filter((p) => p.total > 0);
const sevTotal = Math.max(1, Object.values(stats.bySeverity).reduce((a, b) => a + b, 0));
const trendX = stats.trend.map((w) => Date.parse(`${w.week}T00:00:00Z`) / 1000);
const trendSeries = (["CRITICAL", "HIGH", "MEDIUM", "LOW", "UNSCORED"] as const).map((s) => ({
  label: severityLabel[s],
  colorVar: s === "UNSCORED" ? "--sev-unscored-border" : `--sev-${s.toLowerCase()}-bg`,
  values: stats.trend.map((w) => w.counts[s]),
}));
const kpis = [
  ["Last 24 hours", t.last24h],
  ["Last 7 days", t.last7d],
  ["Last 30 days", t.last30d],
  ["Tracked total", t.all],
  ["In KEV", t.kev],
  ["Added to KEV (30d)", t.kevAdded30d],
] as const;
---

<Layout title="Stats" description="CVE counts by product and severity, KEV additions and trends.">
  <h1 class="text-2xl font-bold tracking-tight">Stats</h1>
  <p class="muted mb-6 text-sm">
    Computed at the last data update ({formatDateTime(stats.generated_at, settings.timezone)}).
    {settings.appSqli && t.appSqli > 0 && <> Excludes {t.appSqli} App SQLi CVEs.</>}
  </p>

  <section aria-label="Key numbers" class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
    {
      kpis.map(([label, value]) => (
        <div class="card p-3">
          <p class="muted text-xs">{label}</p>
          <p class="text-2xl font-bold tabular-nums">{value.toLocaleString("en")}</p>
        </div>
      ))
    }
  </section>

  <section class="card mb-6 p-4" aria-labelledby="trend-h">
    <h2 id="trend-h" class="mb-1 font-semibold">Published per week, by severity</h2>
    <p class="muted mb-3 text-xs">Last {stats.trend.length} weeks (stacked).</p>
    {
      t.all === 0 ? (
        <p class="muted py-8 text-center text-sm">No data yet.</p>
      ) : (
        <Chart client:visible ariaLabel="Weekly CVE counts by severity" x={trendX} series={trendSeries} stacked height={240} yFormat="count" />
      )
    }
  </section>

  <div class="grid gap-6 lg:grid-cols-2">
    <section class="card p-4" aria-labelledby="sev-h">
      <h2 id="sev-h" class="mb-3 font-semibold">By severity</h2>
      <ul class="space-y-2">
        {
          severities.map((s) => (
            <li class="flex items-center gap-3 text-sm">
              <span class={`${severityClass(s)} w-36 justify-center`}>{severityLabel[s]}</span>
              <span class="h-2.5 flex-1 overflow-hidden rounded-full bg-[var(--bg-mute)]">
                <span class={`block h-full sev-bar-${s.toLowerCase()}`} style={`width:${(stats.bySeverity[s] / sevTotal) * 100}%`} />
              </span>
              <span class="w-12 text-right tabular-nums">{stats.bySeverity[s]}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="card p-4" aria-labelledby="kev-h">
      <h2 id="kev-h" class="mb-3 font-semibold">Recent KEV additions</h2>
      {
        stats.kevAdditions.length === 0 ? (
          <p class="muted text-sm">None yet.</p>
        ) : (
          <ul class="divide-y divide-[var(--border)] text-sm">
            {stats.kevAdditions.slice(0, 10).map((k) => {
              const c = cves.get(k.cve_id);
              return (
                <li class="flex items-center gap-2 py-1.5">
                  <a href={cveUrl(k.cve_id)} class="mono font-semibold">{k.cve_id}</a>
                  {c && <span class={severityClass(c.severity)}>{severityLabel[c.severity]}</span>}
                  <span class="muted ml-auto text-xs">{formatDate(k.dateAdded, settings.timezone)}</span>
                </li>
              );
            })}
          </ul>
        )
      }
    </section>
  </div>

  <section class="card mt-6 p-4" aria-labelledby="prod-h">
    <h2 id="prod-h" class="mb-3 font-semibold">By product</h2>
    {
      withCves.length === 0 ? (
        <p class="muted text-sm">No CVEs yet.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full min-w-[520px] text-sm">
            <thead>
              <tr class="muted text-left text-xs">
                <th class="py-1 pr-2 font-medium">Product</th>
                <th class="py-1 pr-2 font-medium">Severity mix</th>
                <th class="py-1 pr-2 text-right font-medium">30d</th>
                <th class="py-1 pr-2 text-right font-medium">KEV</th>
                <th class="py-1 text-right font-medium">Total</th>
              </tr>
            </thead>
            <tbody>
              {withCves.map((p) => (
                <tr class="border-t border-[var(--border)]">
                  <td class="py-1.5 pr-2"><a href={productUrl(p.productId)}>{products.get(p.productId)?.name ?? p.productId}</a></td>
                  <td class="py-1.5 pr-2">
                    <div class="flex h-2.5 overflow-hidden rounded-full bg-[var(--bg-mute)]" style={`width:${Math.max(4, (p.total / maxProduct) * 100)}%`}>
                      {severities.map((s) => p.bySeverity[s] > 0 && <span class={`sev-bar-${s.toLowerCase()}`} style={`width:${(p.bySeverity[s] / p.total) * 100}%`} title={`${severityLabel[s]}: ${p.bySeverity[s]}`} />)}
                    </div>
                  </td>
                  <td class="py-1.5 pr-2 text-right tabular-nums">{p.last30d}</td>
                  <td class="py-1.5 pr-2 text-right tabular-nums">{p.kev || ""}</td>
                  <td class="py-1.5 text-right font-semibold tabular-nums">{p.total}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>
</Layout>
