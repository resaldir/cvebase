---
import "../styles/global.css";
import { stripBase, url } from "../lib/base";
import { loadSettings } from "../lib/config";
import { loadStatus } from "../lib/data/repo";
import { formatDateTime } from "../lib/format";
import { DEMO_NOTICE, isDemo } from "../lib/mode";

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
const settings = loadSettings();
const status = loadStatus();
const demo = isDemo();
const pageTitle = title ? `${title} · ${settings.site.title}` : `${settings.site.title} — database CVE tracker`;
const updated = status.lastSuccessfulRun;
const current = stripBase(import.meta.env.BASE_URL, Astro.url.pathname);

const nav = [
  { href: "/", label: "Feed", match: (p: string) => p === "/" || p.startsWith("/cve/") },
  { href: "/products/", label: "Products", match: (p: string) => p.startsWith("/products") },
  { href: "/changes/", label: "Changes", match: (p: string) => p.startsWith("/changes") },
  { href: "/stats/", label: "Stats", match: (p: string) => p.startsWith("/stats") },
  { href: "/status/", label: "Status", match: (p: string) => p.startsWith("/status") },
  { href: "/api/", label: "API", match: (p: string) => p.startsWith("/api") },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{demo ? `[DEMO] ${pageTitle}` : pageTitle}</title>
    <meta name="description" content={description ?? settings.site.description} />
    {demo && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="alternate" type="application/rss+xml" title={`${settings.site.title} feed`} href={url("/feed.xml")} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Apply the theme before first paint to avoid a flash.
      (() => {
        let t = null;
        try { t = localStorage.getItem("theme"); } catch {}
        const dark = t ? t === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
  </head>
  <body class="min-h-screen font-sans antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 btn">Skip to content</a>
    {
      demo && (
        <div
          role="note"
          class="border-b px-4 py-1.5 text-center text-sm font-semibold"
          style="background:var(--demo-bg);color:var(--demo-fg);border-color:var(--demo-border)"
        >
          {DEMO_NOTICE}. Generated test data — CVE-2099-* IDs are fictional.
        </div>
      )
    }
    <header class="sticky top-0 z-30 border-b border-[var(--border)] bg-[var(--bg)]/95 backdrop-blur">
      <div class={`mx-auto flex flex-wrap items-center gap-x-4 gap-y-1 px-4 py-2 ${wide ? "max-w-7xl" : "max-w-5xl"}`}>
        <a href={url("/")} class="flex items-center gap-2 text-[var(--fg)] no-underline">
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
            <ellipse cx="12" cy="5.5" rx="8" ry="3" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M4 5.5v13c0 1.7 3.6 3 8 3s8-1.3 8-3v-13M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" fill="none" stroke="currentColor" stroke-width="2" />
          </svg>
          <span class="text-lg font-bold tracking-tight">{settings.site.title}</span>
        </a>
        <nav aria-label="Main" class="order-3 -mx-1 flex w-full gap-1 overflow-x-auto pb-1 sm:order-none sm:w-auto sm:pb-0">
          {
            nav.map((n) => (
              <a
                href={url(n.href)}
                aria-current={n.match(current) ? "page" : undefined}
                class="rounded-md px-2.5 py-1.5 text-sm font-medium whitespace-nowrap text-[var(--fg-soft)] no-underline hover:bg-[var(--bg-mute)] aria-[current=page]:bg-[var(--accent-soft)] aria-[current=page]:text-[var(--accent)]"
              >
                {n.label}
              </a>
            ))
          }
        </nav>
        <div class="ml-auto flex items-center gap-2 text-xs">
          <a
            href={url("/status/")}
            class="muted flex items-center gap-1.5 no-underline hover:underline"
            data-updated={updated ?? ""}
            data-stale-after={settings.staleAfterHours}
          >
            <span data-stale-dot class="inline-block h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
            <span>
              Data updated
              <time datetime={updated ?? undefined} data-rel={updated ?? undefined} title={updated ? formatDateTime(updated, settings.timezone) : undefined}>
                {updated ? formatDateTime(updated, settings.timezone) : "never"}
              </time>
            </span>
          </a>
          <button type="button" class="btn !min-h-8 !px-2" data-theme-toggle aria-label="Toggle dark mode" title="Toggle dark mode">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 3a9 9 0 1 0 9 9c0-.5 0-.9-.1-1.3A5.5 5.5 0 0 1 13.3 3.1 9 9 0 0 0 12 3Z" /></svg>
          </button>
        </div>
      </div>
    </header>
    <div
      data-stale-warning
      hidden
      role="alert"
      class="border-b px-4 py-2 text-center text-sm"
      style="background:var(--warn-bg);color:var(--warn-fg);border-color:var(--warn-border)"
    >
      Data may be stale: the last successful update was over {settings.staleAfterHours} hours ago (a daily run was missed).
      <a href={url("/status/")} class="font-semibold" style="color:inherit">See status</a>
    </div>
    <main id="main" class={`mx-auto px-4 py-6 ${wide ? "max-w-7xl" : "max-w-5xl"}`}>
      <slot />
    </main>
    <footer class="border-t border-[var(--border)]">
      <div class="muted mx-auto flex max-w-5xl flex-wrap gap-x-4 gap-y-1 px-4 py-6 text-xs">
        <span>{settings.site.title} — CVEs affecting database products, refreshed daily.</span>
        {demo && <span class="font-semibold">{DEMO_NOTICE}.</span>}
        <span>Times shown in {settings.timezone}.</span>
        <a href={url("/feed.xml")}>RSS</a>
        <a href={url("/api/")}>JSON API</a>
      </div>
    </footer>
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
