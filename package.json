{
  "name": "cvebase",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:pages": "BASE_PATH=/cvebase astro build",
    "preview:pages": "BASE_PATH=/cvebase astro preview",
    "astro": "astro",
    "demo:generate": "bun scripts/demo/generate.ts",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "biome check .",
