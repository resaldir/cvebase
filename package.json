    "minisearch": "^7.2.0",
    "preact": "^11.2.0",
    "tailwindcss": "^4.3.5",
    "uplot": "^1.6.32",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "2.6.8",
    "@types/bun": "^1.4.4",
    "typescript": "^6.0.3"
  }
